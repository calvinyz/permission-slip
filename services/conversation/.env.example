# Copy to .env and fill in. .env is git-ignored; never commit it.
# Only GATEWAY_URL and GATEWAY_API_TOKEN are needed to run. Missing integrations
# (Twilio, Postmark, Slack, Anthropic) run in dry-run mode and show on the dashboard.

# ---- This service ----
PORT=8787
# Public HTTPS URL of THIS service (Tailscale Funnel, ngrok, ...). Needed for Twilio signature checks.
PUBLIC_BASE_URL=
# Must match the company in services/gateway/gateway/seed.py
COMPANY_NAME=Lumen Labs
# Required when PUBLIC_BASE_URL is set: the dashboard and admin endpoints then need ?token=...
DASHBOARD_TOKEN=

# ---- Gateway (services/gateway, Calvin) ----
# Local:  http://localhost:8000   (npm run demo:local starts one for you)
# Calvin: https://calvins-macbook-pro-2.tail56a58a.ts.net
GATEWAY_URL=http://localhost:8000
# Calvin's GATEWAY_API_TOKEN, sent as "Authorization: Bearer <token>". Ask him for it; never commit it.
GATEWAY_API_TOKEN=
# Set false to run without the gateway's event stream (Slack and follow-ups then poll instead)
GATEWAY_EVENTS_ENABLED=true
# Contract the service validates against. Defaults to the repo's api/openapi.yaml.
# CONTRACT_PATH=

# ---- Negotiator ----
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise the deterministic scripted parser
NEGOTIATOR_MODE=auto
ANTHROPIC_API_KEY=
NEGOTIATOR_MODEL=claude-sonnet-5-5
# Where agents check out with the single-use card. Defaults to GATEWAY_URL/merchant.
DEMO_MERCHANT_URL=
# Pin "today" (Pacific) so "Tuesday" resolves to the seed calendar (Acme meeting 2026-10-27) on every take
DEMO_TODAY=2026-10-21
# Text the employee once the charge settles and is coded (spec flow step 7)
NOTIFY_AGENT_ON_RECONCILE=true

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# ---- Email (Postmark), only if Muse can't text ----
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=
# Long random string; Postmark's inbound webhook URL is PUBLIC_BASE_URL/email/inbound?token=<this>
EMAIL_WEBHOOK_TOKEN=
# Reject inbound email unless SPF or DKIM passed (stops spoofing Muse's address)
EMAIL_REQUIRE_AUTH=true

# ---- Slack (Socket Mode; see slack-manifest.yaml) ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_MANAGER_CHANNEL=
SLACK_FINANCE_CHANNEL=
# Slack user ids (U...) for the seed employees. The gateway names the approver (Priya for
# Engineering, Jordan for Sales); only that person can click Approve or Deny, and they're @-mentioned.
# A click from a Slack user who isn't mapped here is refused.
SLACK_ID_PRIYA=
SLACK_ID_JORDAN=
SLACK_ID_SAM=
SLACK_ID_MAYA=
SLACK_ID_DEV=
# Test workspaces only: let anyone in the manager channel resolve for approvers with no Slack id
SLACK_OPEN_APPROVALS=false

# ---- Agent enrollment (referenced by data/enrollment.json) ----
# Phone numbers the agents text FROM, in E.164 (+15551234567)
INSTINCT_NUMBER_MAYA=
MUSE_NUMBER_DEV=
MUSE_EMAIL_DEV=
# Your own phone, to rehearse the SMS flow as Maya
REHEARSAL_NUMBER_MAYA=
# Per-employee MCP tokens (generate each with: openssl rand -hex 24)
MCP_TOKEN_CLAUDE_DEV=
MCP_TOKEN_CHATGPT_DEV=
MCP_TOKEN_CLAUDE_MAYA=

# ---- Files ----
ENROLLMENT_FILE=data/enrollment.json
# Keeps conversations across restarts between takes
STATE_FILE=data/state.json
LOG_FILE=logs/conversation.log
LOG_LEVEL=info
